# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Option A: Full connection string (Neon / Supabase / Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/selo_db

# Option B: Individual fields (local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=selo_db
DB_USER=postgres
DB_PASSWORD=your_password

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Cloudinary (optional for MVP) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Stripe (stubbed for MVP) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
